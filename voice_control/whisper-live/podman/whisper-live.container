[Unit]
Description="Whisper Live"
#After=example_2a.container
#Wants=mqtt.container zwave-js-ui.container
#Requires=example_2a.container

[Container]
ContainerName=whisper-live
Image=docker.io/hwdsl2/whisper-live-server

#Websocket port for real-time streaming clients
PublishPort=9090:9090
#HTTP port for REST API 
PublishPort=8000:8000

#Explicitly set empty to disable key
Environment=WHISPERLIVE_API_KEY=""
#Set to number of physical cores for best latency
Environment=WHISPERLIVE_THREADS=4

#DEBUG, INFO, WARNING, ERROR, CRITICAL
Environment=WHISPERLIVE_LOG_LEVEL=WARNING

#AddCapability=SYS_NICE
#GroupAdd=audio

#This volume contains downloaded models. Once downloaded, can run in local only mode.
Volume=whisper-live-data:/var/lib/whisper-live
Environment=WHISPERLIVE_LOCAL_ONLY=true

[Service]
Restart=always

#Default for systemd is 90 seconds. This allows the container more time to start.
TimeoutStartSec=180
#Wait 10 seconds before attempting a restart
RestartSec=10

[Install]
# Start by default on boot
WantedBy=default.target